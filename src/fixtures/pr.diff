@@ -0,0 +1,9 @@
+//! pwrde in a browser: the same `App` the macOS binary runs, booted through
+//! gpui's web platform and drawn to a full-page canvas.
+
+fn main() {
+    gpui_platform::web_init();
+    let query = Query::from_location();
+    pwrde::settings::init();
+    boot(query);
+}
